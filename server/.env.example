# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/scaniq?schema=public"

# Redis Cache & Session Store
REDIS_URL="redis://localhost:6379"

# Frontend Application URL (CORS Allowed Origin)
CLIENT_URL="http://localhost:5173"

# JWT Authentication (Minimum 32 characters)
JWT_SECRET="replace_with_a_secure_random_at_least_32_chars_secret"

# Google Gemini AI Service
AI_API_KEY="replace_with_your_gemini_api_key"
AI_MODEL="gemini-2.0-flash"